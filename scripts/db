#!/usr/bin/env bash
# Local database helper. Usage: pnpm db <command>
#   up        start Postgres (docker compose)
#   down      stop Postgres
#   reset     drop the volume and start fresh
#   psql      open psql against DATABASE_URL (extra args pass through, e.g. `pnpm db psql -c 'select 1'`)
#   sql FILE  run a .sql file
#   migrate   apply Drizzle migrations
#   generate  generate a Drizzle migration from schema changes
#   studio    open Drizzle Studio
#   tables    list tables with row estimates and sizes
#   explain   read a query from stdin and EXPLAIN (ANALYZE, BUFFERS) it
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f .env ] && set -a && . ./.env && set +a
: "${DATABASE_URL:=postgres://instruments:instruments@localhost:5433/instruments}"
export DATABASE_URL

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)       docker compose up -d postgres && until docker compose exec -T postgres pg_isready -U instruments >/dev/null 2>&1; do sleep 1; done; echo "postgres ready at $DATABASE_URL" ;;
  down)     docker compose down ;;
  reset)    docker compose down -v && "$0" up ;;
  psql)     exec psql "$DATABASE_URL" "$@" ;;
  sql)      exec psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f "$1" ;;
  migrate)  pnpm --filter @instruments/db migrate ;;
  generate) pnpm --filter @instruments/db generate ;;
  studio)   pnpm --filter @instruments/db studio ;;
  tables)   psql "$DATABASE_URL" -c "select schemaname, relname, n_live_tup as rows_est, pg_size_pretty(pg_total_relation_size(relid)) as size from pg_stat_user_tables order by pg_total_relation_size(relid) desc;" ;;
  explain)  { printf 'EXPLAIN (ANALYZE, BUFFERS, FORMAT TEXT) '; cat; } | psql "$DATABASE_URL" ;;
  *)        sed -n '2,13p' "$0" ;;
esac
