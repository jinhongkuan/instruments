# Local Postgres (docker-compose.yml). Port 5433 avoids clashing with a host install.
DATABASE_URL=postgres://instruments:instruments@localhost:5433/instruments

# Alchemy encrypts secrets in state with this password.
ALCHEMY_PASSWORD=change-me

# Production database URL for the Cloudflare Hyperdrive binding (set in CI / shell, not committed).
# HYPERDRIVE_ORIGIN_URL=postgres://user:pass@host:5432/instruments
